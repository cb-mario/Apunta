@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Se ha producido un error al procesar la petición.</h2>

@* El RequestId identifica esta petición en los logs del servidor, para
   poder buscar qué falló sin enseñar detalles internos al usuario *@
@if (Model.ShowRequestId)
{
    <p>
        <strong>Código de la petición:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Tareas" asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
