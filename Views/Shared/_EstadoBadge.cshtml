@* Badge de estado, compartido por Index, Details y Delete *@
@model EstadoTarea

@{
    var (color, icono) = Model switch
    {
        EstadoTarea.Pendiente => ("text-bg-secondary", "bi-circle"),
        EstadoTarea.EnProgreso => ("text-bg-warning", "bi-hourglass-split"),
        _ => ("text-bg-success", "bi-check-circle")
    };
}

<span class="badge @color"><i class="bi @icono me-1"></i>@Html.DisplayFor(m => m)</span>
