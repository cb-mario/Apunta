@model TareasIndexViewModel

@{
    ViewData["Title"] = "Tareas";

    // Las opciones del desplegable tienen como valor el número del enum en texto
    var estadoSeleccionado = ((int?)Model.EstadoSeleccionado)?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Mis tareas</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nueva tarea
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a asp-action="Index" class="card shadow-sm text-decoration-none h-100 @(Model.EstadoSeleccionado == null ? "border border-2 border-primary" : "border-0")">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-list-task fs-2 text-primary"></i>
                <div>
                    <div class="text-muted small">Total</div>
                    <div class="fs-4 fw-bold text-body">@Model.Total</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-action="Index" asp-route-estado="@EstadoTarea.Pendiente" class="card shadow-sm text-decoration-none h-100 @(Model.EstadoSeleccionado == EstadoTarea.Pendiente ? "border border-2 border-secondary" : "border-0")">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-circle fs-2 text-secondary"></i>
                <div>
                    <div class="text-muted small">Pendientes</div>
                    <div class="fs-4 fw-bold text-body">@Model.TotalPendientes</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-action="Index" asp-route-estado="@EstadoTarea.EnProgreso" class="card shadow-sm text-decoration-none h-100 @(Model.EstadoSeleccionado == EstadoTarea.EnProgreso ? "border border-2 border-warning" : "border-0")">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-hourglass-split fs-2 text-warning"></i>
                <div>
                    <div class="text-muted small">En progreso</div>
                    <div class="fs-4 fw-bold text-body">@Model.TotalEnProgreso</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-action="Index" asp-route-estado="@EstadoTarea.Completada" class="card shadow-sm text-decoration-none h-100 @(Model.EstadoSeleccionado == EstadoTarea.Completada ? "border border-2 border-success" : "border-0")">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-check-circle fs-2 text-success"></i>
                <div>
                    <div class="text-muted small">Completadas</div>
                    <div class="fs-4 fw-bold text-body">@Model.TotalCompletadas</div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body py-3">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <select name="estado" class="form-select w-auto" aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                @foreach (var opcion in Html.GetEnumSelectList<EstadoTarea>())
                {
                    <option value="@opcion.Value" selected="@(opcion.Value == estadoSeleccionado)">@opcion.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-funnel me-1"></i> Filtrar
            </button>
        </form>
    </div>

    @if (Model.Tareas.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No hay tareas que mostrar.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">@Html.DisplayNameFor(m => m.Tareas[0].Titulo)</th>
                        <th>@Html.DisplayNameFor(m => m.Tareas[0].Estado)</th>
                        @* En móvil se oculta la fecha para que la tabla quepa *@
                        <th class="d-none d-md-table-cell">@Html.DisplayNameFor(m => m.Tareas[0].FechaLimite)</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tarea in Model.Tareas)
                    {
                        <tr>
                            <td class="ps-3">
                                <a asp-action="Details" asp-route-id="@tarea.Id" class="fw-semibold text-decoration-none">@tarea.Titulo</a>
                                <div class="text-muted small">Creada el @tarea.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                @* Como en móvil no hay columna de fecha, el aviso de vencida va aquí *@
                                @if (tarea.EstaVencida)
                                {
                                    <span class="badge text-bg-danger d-md-none"><i class="bi bi-exclamation-triangle me-1"></i>Vencida</span>
                                }
                            </td>
                            <td>
                                <partial name="_EstadoBadge" model="tarea.Estado" />
                            </td>
                            <td class="d-none d-md-table-cell @(tarea.EstaVencida ? "text-danger fw-semibold" : "")">
                                @(tarea.FechaLimite?.ToString("dd/MM/yyyy") ?? "—")
                                @if (tarea.EstaVencida)
                                {
                                    <span class="badge text-bg-danger ms-1"><i class="bi bi-exclamation-triangle me-1"></i>Vencida</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    @if (tarea.Estado != EstadoTarea.Completada)
                                    {
                                        <form asp-action="Completar" asp-route-id="@tarea.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Marcar como completada">
                                                <i class="bi bi-check-lg"></i><span class="visually-hidden">Marcar como completada</span>
                                            </button>
                                        </form>
                                    }
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@tarea.Id" class="btn btn-outline-primary" title="Ver">
                                            <i class="bi bi-eye"></i><span class="visually-hidden">Ver</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@tarea.Id" class="btn btn-outline-secondary" title="Editar">
                                            <i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@tarea.Id" class="btn btn-outline-danger" title="Borrar">
                                            <i class="bi bi-trash"></i><span class="visually-hidden">Borrar</span>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
