@* Igual que Create, pero el modelo llega relleno con la tarea que se edita *@
@model Tarea

@{
    ViewData["Title"] = "Editar tarea";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4"><i class="bi bi-pencil-square me-1"></i> Editar tarea</h1>

                @* asp-route-id añade el Id a la URL (/Tareas/Edit/5). Es la forma en
                   que el POST sabe qué tarea guardar: el controlador lo recibe en su
                   parámetro "id", ya que el Id no viaja como campo del formulario. *@
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* Los campos son los mismos que en Create. Aquí asp-for además
                       rellena cada uno con el valor actual de la tarea. *@
                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoTarea>()" class="form-select"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FechaLimite" class="form-label"></label>
                        <input asp-for="FechaLimite" class="form-control" />
                    </div>

                    @* FechaCreacion no aparece: no se puede editar, y el controlador
                       conserva la original al guardar *@
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Guardar cambios
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
