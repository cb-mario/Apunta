@* Página de confirmación: muestra la tarea y solo se borra si se pulsa el botón *@
@model Tarea

@{
    ViewData["Title"] = "Borrar tarea";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm">
            <div class="card-header text-bg-danger py-3">
                <h1 class="h5 mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Borrar tarea</h1>
            </div>

            <div class="card-body">
                <p>¿Seguro que quieres borrar esta tarea? <strong>Esta acción no se puede deshacer.</strong></p>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.Titulo)</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Titulo</dd>

                    <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.Estado)</dt>
                    <dd class="col-sm-8"><partial name="_EstadoBadge" model="Model.Estado" /></dd>

                    <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.FechaLimite)</dt>
                    <dd class="col-sm-8 mb-0">@(Model.FechaLimite?.ToString("dd/MM/yyyy") ?? "Sin fecha límite")</dd>
                </dl>
            </div>

            <div class="card-footer bg-body py-3">
                @* El borrado va en un formulario POST y no en un enlace: los enlaces hacen
                   GET, y un GET nunca debe modificar datos. Este POST llega al
                   DeleteConfirmed del controlador gracias a su [ActionName("Delete")]. *@
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Sí, borrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
