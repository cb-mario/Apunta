@* Aquí el modelo es UNA tarea (no una lista), la que devuelve
   el controlador con View(tarea) *@
@model Tarea

@{
    ViewData["Title"] = "Detalle de la tarea";
}

<h1>@Model.Titulo</h1>

@* <dl> es una "lista de definiciones": pares de nombre (dt) y valor (dd).
   Con las clases row/col de Bootstrap se ven en dos columnas. *@
<dl class="row mt-3">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Estado)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Estado)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Descripcion)</dt>
    @* white-space: pre-line respeta los saltos de línea que se escribieron
       en la descripción; sin esto, el HTML lo juntaría todo en una línea *@
    <dd class="col-sm-9" style="white-space: pre-line">@(Model.Descripcion ?? "Sin descripción")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FechaLimite)</dt>
    <dd class="col-sm-9">
        @(Model.FechaLimite?.ToString("dd/MM/yyyy") ?? "Sin fecha límite")
        @if (Model.EstaVencida)
        {
            <span class="badge bg-danger ms-1">Vencida</span>
        }
    </dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FechaCreacion)</dt>
    <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
